<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="444.0" prefWidth="721.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ni.edu.uam.serviciosweb.controller.UsuarioController">
    <children>
        <Label layoutX="24.0" layoutY="14.0" prefHeight="25.0" prefWidth="268.0" text="Consulta de usuarios - API REST">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Label>
        <Button fx:id="btnConsultar" layoutX="24.0" layoutY="45.0" mnemonicParsing="false" onAction="#consultarUsuarios" text="Consultar usuarios" />
        <Label fx:id="lblEstado" layoutX="145.0" layoutY="49.0" text="Presione Consultar usuarios" />
        <TableView fx:id="tblUsuarios" layoutX="14.0" layoutY="90.0" prefHeight="340.0" prefWidth="694.0">
            <columns>
                <TableColumn fx:id="colId" prefWidth="57.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="134.0" text="Nombre" />
                <TableColumn fx:id="colUsername" prefWidth="95.0" text="Username" />
                <TableColumn fx:id="colEmail" prefWidth="128.0" text="Correo" />
                <TableColumn fx:id="colTelefono" prefWidth="84.0" text="Teléfono" />
                <TableColumn fx:id="colCiudad" prefWidth="98.0" text="Ciudad" />
                <TableColumn fx:id="colEmpresa" prefWidth="97.0" text="Empresa" />
            </columns>
        </TableView>
    </children>
</AnchorPane>